# Neon pooled connection，給網站查詢使用，hostname 通常包含 -pooler
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15&pool_timeout=15&connection_limit=5"

# Neon direct connection，給 Prisma migration 使用，hostname 通常不包含 -pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"

ADMIN_PASSWORD="change-this-admin-password"
ADMIN_SESSION_SECRET="change-this-random-secret"
NEXT_PUBLIC_APP_NAME="員工車上車登記系統"
