# Railway PostgreSQL reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

ADMIN_PASSWORD="change-this-admin-password"
ADMIN_SESSION_SECRET="change-this-long-random-secret"
APP_BASE_URL="https://your-service.up.railway.app"
NEXT_PUBLIC_APP_NAME="員工車上車登記系統"

# LINE Login / LIFF. The LIFF endpoint is ${APP_BASE_URL}/liff.
NEXT_PUBLIC_LINE_LIFF_ID="1234567890-AbCdEfGh"
LINE_LOGIN_CHANNEL_ID="1234567890"
LINE_SESSION_SECRET="change-this-separate-long-random-secret"
# Defaults to enabled whenever LINE_LOGIN_CHANNEL_ID is configured.
LINE_IDENTITY_REQUIRED="true"

# Minutes before departure when employee registration and self-cancellation close.
BOOKING_CUTOFF_MINUTES="60"

# LINE Messaging API. Keep secrets and real target IDs in Railway/local env only.
LINE_CHANNEL_ACCESS_TOKEN=""
# Comma-separated LINE user/group/room IDs that receive new-booking notices.
LINE_GRO_TARGET_IDS=""

# Optional non-LIFF URI overrides.
LINE_HELP_URL=""
LINE_ADMIN_URL=""
